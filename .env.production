# Production Environment Variables for Docker
# Copy this to .env.production.local and customize

# Next.js
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Port configuration (internal container port)
PORT=3000

# Optional: Database path (if you want to customize)
# DATABASE_PATH=/app/dbs/bible-sqlite.db

# Optional: Add any API keys or external service URLs here
# EXTERNAL_API_URL=https://api.example.com
